{
  "name": "wordsafe",
  "version": "4.0.0",
  "author": "Jon Smithers @jonsmithers",
  "bin": {
    "wordsafe": "./bin/run"
  },
  "bugs": "https://github.com/jonsmithers/wordsafe/issues",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/bin",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/jonsmithers/wordsafe",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "wordsafe",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete"
    ]
  },
  "repository": "jonsmithers/wordsafe",
  "scripts": {
    "postpack": "rm -f oclif.manifest.json",
    "posttest": "eslint src/",
    "prepack": "rm -rf lib && tsc -b && oclif manifest && oclif readme",
    "test": "nyc --extension .ts mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "lib/index.d.ts",
  "dependencies": {
    "@oclif/core": "^4.10.5",
    "@oclif/plugin-autocomplete": "^3.2.45",
    "@oclif/plugin-help": "*",
    "cli-ux": "*",
    "combined-stream": "*",
    "secure-remove": "*",
    "stream-to-promise": "*",
    "tmp": "^0.2.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@oclif/test": "^4.1.18",
    "@types/chai": "^5.2.3",
    "@types/combined-stream": "^1.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/stream-to-promise": "^2.2.5",
    "@types/tmp": "^0.2.6",
    "chai": "^6.2.2",
    "eslint": "^10.2.1",
    "eslint-config-oclif": "^6.0.159",
    "globby": "^11.1.0",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "oclif": "*",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
