{
  "name": "wordsafe",
  "version": "3.0.1",
  "author": "Jon Smithers @jonsmithers",
  "bin": {
    "wordsafe": "./bin/run"
  },
  "bugs": "https://github.com/jonsmithers/wordsafe/issues",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/bin",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/jonsmithers/wordsafe",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "wordsafe",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete"
    ]
  },
  "repository": "jonsmithers/wordsafe",
  "scripts": {
    "postpack": "rm -f oclif.manifest.json",
    "posttest": "eslint . --ext .ts --config .eslintrc",
    "prepack": "rm -rf lib && tsc -b && oclif manifest && oclif readme",
    "test": "nyc --extension .ts mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "lib/index.d.ts",
  "dependencies": {
    "@oclif/core": "*",
    "@oclif/plugin-autocomplete": "*",
    "@oclif/plugin-help": "*",
    "@types/combined-stream": "*",
    "@types/stream-to-promise": "*",
    "@types/tmp": "*",
    "cli-ux": "*",
    "combined-stream": "*",
    "secure-remove": "*",
    "stream-to-promise": "*",
    "tmp": "*",
    "tslib": "*"
  },
  "devDependencies": {
    "oclif": "*",
    "@oclif/test": "*",
    "@types/chai": "*",
    "@types/mocha": "*",
    "@types/node": "*",
    "chai": "*",
    "eslint": "*",
    "eslint-config-oclif": "*",
    "eslint-config-oclif-typescript": "*",
    "globby": "^11.1.0",
    "mocha": "*",
    "nyc": "*",
    "ts-node": "*",
    "typescript": "*"
  }
}
